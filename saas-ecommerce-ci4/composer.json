{
    "name": "bhuiyansoft/saas-ecommerce-ci4",
    "description": "SaaS-based E-Commerce System built with CodeIgniter 4, MySQL, Bootstrap 5",
    "license": "MIT",
    "require": {
        "php": "^8.1",
        "codeigniter4/framework": "^4.5"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5",
        "codeigniter4/devkit": "^1.1"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Config\\": "app/Config/"
        },
        "exclude-from-classmap": [
            "**/Database/Migrations/**"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\Support\\": "tests/support/"
        }
    },
    "scripts": {
        "post-update-cmd": [
            "CodeIgniter\\ComposerScripts::postUpdate"
        ]
    },
    "config": {
        "allow-plugins": {
            "codeigniter4/devkit": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
